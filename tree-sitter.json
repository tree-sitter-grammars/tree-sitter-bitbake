{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "bitbake",
      "camelcase": "BitBake",
      "title": "BitBake",
      "scope": "source.bitbake",
      "file-types": [
        "bbclass",
        "bb"
      ],
      "injection-regex": "^(bb|bbclass)$",
      "highlights": [
        "queries/highlights.scm"
      ],
      "injections": [
        "queries/injections.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ],
      "class-name": "TreeSitterBitbake"
    }
  ],
  "metadata": {
    "version": "1.1.0",
    "license": "MIT",
    "description": "BitBake grammar for tree-sitter",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-bitbake"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
